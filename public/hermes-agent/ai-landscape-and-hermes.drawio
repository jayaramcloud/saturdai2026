<mxfile host="app.diagrams.net" agent="SaturdAI generator" version="24.0.0"><diagram name="1 · The Agentic AI Landscape" id="landscape"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1802" background="#faf8f3" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="landscape-1" value="The Agentic AI Landscape — and Where Hermes Agent Fits" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1f2328;fontSize=36;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="2420" height="50" as="geometry"/></mxCell><mxCell id="landscape-2" value="SaturdAI · Agentic AI with Hermes Agent · Day 1 companion map  —  how we got here, the full stack, the product landscape, and the autonomy spectrum" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="2420" height="30" as="geometry"/></mxCell><mxCell id="landscape-3" value="① HOW WE GOT HERE — from scripted bots to always-on agents" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="1200" height="30" as="geometry"/></mxCell><mxCell id="landscape-4" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;Rule-based bots&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#3a3f47&#x27;&gt;&lt;b&gt;1960s–2010s&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#6b6f76&#x27;&gt;Scripted if/then trees. No understanding, can’t handle anything off-script.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="318" height="120" as="geometry"/></mxCell><mxCell id="landscape-5" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;Machine learning&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#3a3f47&#x27;&gt;&lt;b&gt;2010s&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#6b6f76&#x27;&gt;Models learn to classify &amp; predict from data — but each one does one narrow job.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="388" y="150" width="318" height="120" as="geometry"/></mxCell><mxCell id="landscape-6" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;LLM chatbots&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#3a3f47&#x27;&gt;&lt;b&gt;2022 →&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#6b6f76&#x27;&gt;ChatGPT moment: models that can talk about anything — but can only &lt;i&gt;talk&lt;/i&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="736" y="150" width="318" height="120" as="geometry"/></mxCell><mxCell id="landscape-7" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;Tool / function calling&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#3a3f47&#x27;&gt;&lt;b&gt;2023 →&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#6b6f76&#x27;&gt;Model emits structured JSON asking your code to run a function. First real actions.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1084" y="150" width="318" height="120" as="geometry"/></mxCell><mxCell id="landscape-8" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;Agent frameworks&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#3a3f47&#x27;&gt;&lt;b&gt;2023–24&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#6b6f76&#x27;&gt;LangChain, AutoGen, CrewAI: developers hand-wire the plan→act→observe loop in code.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1432" y="150" width="318" height="120" as="geometry"/></mxCell><mxCell id="landscape-9" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;Agent harnesses + MCP&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#3a3f47&#x27;&gt;&lt;b&gt;2024–25&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#6b6f76&#x27;&gt;Ready-made loops (Claude Code, Codex CLI…) and MCP as a universal tool plug.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1780" y="150" width="318" height="120" as="geometry"/></mxCell><mxCell id="landscape-10" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;Always-on personal agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#c2410c&#x27;&gt;&lt;b&gt;2025–26&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#1f2328&#x27;&gt;Memory, skills, schedules, chat-app gateways. &lt;b&gt;Hermes Agent&lt;/b&gt; lives here.&lt;/span&gt;" style="rounded=1;whiteSp