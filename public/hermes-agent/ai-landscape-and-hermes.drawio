-128" value="&lt;b&gt;Agent is light&lt;/b&gt; — runs on a laptop or $5 VPS;&lt;br&gt;the model can live on the big box&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.5;dashed=1;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1165" y="1224" width="285" height="100" as="geometry"/></mxCell><mxCell id="landscape-129" value="Day 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1382" y="1294" width="62" height="24" as="geometry"/></mxCell><mxCell id="landscape-130" value="Arrows of dependency run downward: every layer only works because the one beneath it exists. Hermes sits in the runtime layer but has a hand in almost every other one." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1332" width="1410" height="26" as="geometry"/></mxCell><mxCell id="landscape-131" value="③ THE PRODUCT LANDSCAPE — who builds what" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1490" y="320" width="970" height="30" as="geometry"/></mxCell><mxCell id="landscape-132" value="" style="html=1;strokeColor=#1f2328;strokeWidth=2;dashed=0;fontColor=#1f2328;fontSize=13;endArrow=block;endFill=1;labelBackgroundColor=#faf8f3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1530" y="1308" as="sourcePoint"/><mxPoint x="1530" y="365" as="targetPoint"/></mxGeometry></mxCell><mxCell id="landscape-133" value="" style="html=1;strokeColor=#1f2328;strokeWidth=2;dashed=0;fontColor=#1f2328;fontSize=13;endArrow=block;endFill=1;labelBackgroundColor=#faf8f3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1530" y="1308" as="sourcePoint"/><mxPoint x="2450" y="1308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="landscape-134" value="More autonomous &amp;amp; persistent →" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1f2328;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;horizontal=0;" vertex="1" parent="1"><mxGeometry x="1470" y="365" width="50" height="938" as="geometry"/></mxCell><mxCell id="landscape-135" value="Build it yourself (code)  ————————→  Ready to run (product)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1f2328;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1530" y="1316" width="920" height="26" as="geometry"/></mxCell><mxCell id="landscape-136" value="" style="html=1;strokeColor=#c9c4b8;strokeWidth=1.5;dashed=1;fontColor=#1f2328;fontSize=13;endArrow=none;endFill=1;labelBackgroundColor=#faf8f3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1990" y="365" as="sourcePoint"/><mxPoint x="1990" y="1308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="landscape-137" value="" style="html=1;strokeColor=#c9c4b8;strokeWidth=1.5;dashed=1;fontColor=#1f2328;fontSize=13;endArrow=none;endFill=1;labelBackgroundColor=#faf8f3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1530" y="836" as="sourcePoint"/><mxPoint x="2450" y="836" as="targetPoint"/></mxGeometry></mxCell><mxCell id="landscape-138" value="AUTONOMOUS · YOU BUILD IT" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="367" width="300" height="22" as="geometry"/></mxCell><mxCell id="landscape-139" value="AUTONOMOUS · READY TO RUN" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#c2410c;fontSize=12;fontStyle=1;align=right;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2140" y="367" width="300" height="22" as="geometry"/></mxCell><mxCell id="landscape-140" value="ASSISTIVE · BUILDING BLOCKS" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="1282" width="300" height="22" as="geometry"/></mxCell><mxCell id="landscape-141" value="ASSISTIVE · READY TO RUN" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=12;fontStyle=1;align=right;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2140" y="1282" width="300" height="22" as="geometry"/></mxCell><mxCell id="landscape-142" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;Early autonomous experiments&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;AutoGPT · BabyAGI · AgentGPT&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;&lt;i&gt;2023: proved the idea, too brittle to trust&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1550" y="401" width="380" height="118" as="geometry"/></mxCell><mxCell id="landscape-143" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;Agent frameworks &amp; SDKs&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;LangChain / LangGraph · CrewAI · AutoGen / AG2 · LlamaIndex · OpenAI Agents SDK · Claude Agent SDK · Google ADK · Pydantic AI · smolagents&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;&lt;i&gt;Powerful, but you write the agent in Python/TS&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1550" y="551" width="380" height="150" as="geometry"/></mxCell><mxCell id="landscape-144" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;Low-code workflow builders&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;n8n · Dify · Flowise · Zapier Agents&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;&lt;i&gt;Drag-and-drop flows with LLM steps&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1550" y="1138" width="380" height="110" as="geometry"/></mxCell><mxCell id="landscape-145" value="&lt;b style=&#x27;font-size:15px;color:#c2410c&#x27;&gt;Always-on personal agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2010" y="401" width="400" height="310" as="geometry"/></mxCell><mxCell id="landscape-146" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;★ HERMES AGENT&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;by Nous Research · open source&lt;br&gt;memory · skills · MCP · cron · subagents&lt;br&gt;Telegram / Discord / Slack / WhatsApp / Signal&lt;br&gt;any model, local or cloud&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0e7;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2030" y="439" width="360" height="150" as="geometry"/></mxCell><mxCell id="landscape-147" value="&lt;b&gt;Neighbors:&lt;/b&gt; OpenClaw · Manus&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#6b6f76&#x27;&gt;Same idea: an agent that lives somewhere, remembers you, and works while you’re away&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2030" y="601" width="360" height="96" as="geometry"/></mxCell><mxCell id="landscape-148" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;Enterprise agent platforms&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Microsoft Copilot Studio · Salesforce Agentforce · AWS Bedrock Agents · Vertex AI Agent Builder&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;&lt;i&gt;Managed, governed, vendor cloud&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1790" y="866" width="360" height="120" as="geometry"/></mxCell><mxCell id="landscape-149" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;Coding agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Claude Code · Codex CLI · Gemini CLI · Cursor · Aider · OpenHands&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;&lt;i&gt;Autonomous, but scoped to a repo&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2180" y="726" width="250" height="200" as="geometry"/></mxCell><mxCell id="landscape-150" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;Computer / browser use&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;ChatGPT agent · Claude computer use · Browser Use&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;&lt;i&gt;Clicks &amp; types in a real UI&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2180" y="946" width="250" height="130" as="geometry"/></mxCell><mxCell id="landscape-151" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;Chat assistants&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;ChatGPT · Claude.ai · Gemini · Open WebUI&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;&lt;i&gt;You drive every turn&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=1.8;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2050" y="1158" width="380" height="110" as="geometry"/></mxCell><mxCell id="landscape-152" value="④ THE AUTONOMY SPECTRUM — how much the AI does without you" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1392" width="2420" height="30" as="geometry"/></mxCell><mxCell id="landscape-153" value="&lt;b style=&#x27;font-size:16px;color:#3a3f47&#x27;&gt;Level 0 · Chat&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Answers questions. You copy/paste the result into the real world.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1432" width="452" height="92" as="geometry"/></mxCell><mxCell id="landscape-154" value="&lt;b style=&#x27;font-size:16px;color:#3a3f47&#x27;&gt;Level 1 · Copilot&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Suggests inline (autocomplete, drafts). You accept or reject each one.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1432" width="452" height="92" as="geometry"/></mxCell><mxCell id="landscape-155" value="&lt;b style=&#x27;font-size:16px;color:#3a3f47&#x27;&gt;Level 2 · Tool-using assistant&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Calls one tool when asked (“what time is it in Tokyo?”), then stops.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="1432" width="452" height="92" as="geometry"/></mxCell><mxCell id="landscape-156" value="&lt;b style=&#x27;font-size:16px;color:#3a3f47&#x27;&gt;Level 3 · Agent&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Loops plan → act → observe on its own until the task is actually done.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1510" y="1432" width="452" height="92" as="geometry"/></mxCell><mxCell id="landscape-157" value="&lt;b style=&#x27;font-size:16px;color:#c2410c&#x27;&gt;Level 4 · Always-on agent&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Remembers you, runs on a schedule, reaches out on chat apps — works while you sleep.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2000" y="1432" width="452" height="92" as="geometry"/></mxCell><mxCell id="landscape-158" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6b6f76;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;" edge="1" parent="1" source="landscape-153" target="landscape-154"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="landscape-159" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6b6f76;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;" edge="1" parent="1" source="landscape-154" target="landscape-155"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="landscape-160" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6b6f76;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;" edge="1" parent="1" source="landscape-155" target="landscape-156"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="landscape-161" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6b6f76;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;" edge="1" parent="1" source="landscape-156" target="landscape-157"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="landscape-162" value="&lt;b&gt;Hermes Agent spans Levels 3 → 4:&lt;/b&gt; an agent loop out of the box (Day 2–6), always-on once you add memory + cron + the gateway (Day 7 capstone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=1;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1510" y="1538" width="942" height="58" as="geometry"/></mxCell><mxCell id="landscape-163" value="Most people’s AI use today is Levels 0–2. The jump to Level 3 is the jump from &lt;i&gt;“AI that talks”&lt;/i&gt; to &lt;i&gt;“AI that does.”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#6b6f76;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1538" width="1432" height="58" as="geometry"/></mxCell><mxCell id="landscape-164" value="⑤ KEY TAKEAWAYS" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1632" width="2420" height="30" as="geometry"/></mxCell><mxCell id="landscape-165" value="&lt;b style=&#x27;font-size:17px;color:#c2410c&#x27;&gt;Hermes is a harness, not a model&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:14px&#x27;&gt;It’s the loop, tools, memory and plumbing &lt;i&gt;around&lt;/i&gt; an LLM. Nous Research also publishes the open-weight &lt;i&gt;Hermes&lt;/i&gt; LLMs — Hermes Agent can run those, or GPT, Claude, Qwen, anything.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="786" height="100" as="geometry"/></mxCell><mxCell id="landscape-166" value="&lt;b style=&#x27;font-size:17px;color:#3a3f47&#x27;&gt;It’s the glue between layers&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:14px&#x27;&gt;Down: any OpenAI-compatible model server. Sideways: MCP tools, skills, RAG. Up: CLI, Telegram, Discord, Slack, cron. Learn Hermes and you’ve touched every layer of the stack.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="856" y="1670" width="786" height="100" as="geometry"/></mxCell><mxCell id="landscape-167" value="&lt;b style=&#x27;font-size:17px;color:#3a3f47&#x27;&gt;Why we teach with it&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:14px&#x27;&gt;Open source, runs on our own DGX Spark + Mac Mini, no code required to start, and it goes all the way to a real 24x7 agent — the skills transfer to every other tool on this map.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=top;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="1670" width="786" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Inside Hermes Agent" id="anatomy"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1260" background="#faf8f3" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="anatomy-1" value="Inside Hermes Agent — anatomy of an always-on agent" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1f2328;fontSize=36;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="2320" height="50" as="geometry"/></mxCell><mxCell id="anatomy-2" value="Everything wraps one loop. Badges show which course session covers each part." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1080" height="30" as="geometry"/></mxCell><mxCell id="anatomy-3" value="Day 1 · Intro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1150" y="64" width="150" height="26" as="geometry"/></mxCell><mxCell id="anatomy-4" value="Day 2 · Fundamentals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1306" y="64" width="150" height="26" as="geometry"/></mxCell><mxCell id="anatomy-5" value="Day 3 · Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1462" y="64" width="150" height="26" as="geometry"/></mxCell><mxCell id="anatomy-6" value="Day 4 · RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1618" y="64" width="150" height="26" as="geometry"/></mxCell><mxCell id="anatomy-7" value="Day 5 · MCPs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1774" y="64" width="150" height="26" as="geometry"/></mxCell><mxCell id="anatomy-8" value="Day 6 · Tools &amp; loops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1930" y="64" width="150" height="26" as="geometry"/></mxCell><mxCell id="anatomy-9" value="Day 7 · Deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2086" y="64" width="150" height="26" as="geometry"/></mxCell><mxCell id="anatomy-10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffcf8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=4;" vertex="1" parent="1"><mxGeometry x="860" y="390" width="780" height="560" as="geometry"/></mxCell><mxCell id="anatomy-11" value="HERMES AGENT CORE — the agent loop" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#c2410c;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="398" width="740" height="30" as="geometry"/></mxCell><mxCell id="anatomy-12" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;1 · Receive&lt;/b&gt;&lt;br&gt;a message from the CLI, a chat app, or a scheduled job — plus memory &amp;amp; skill context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="280" height="120" as="geometry"/></mxCell><mxCell id="anatomy-13" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;2 · Think&lt;/b&gt;&lt;br&gt;send context + the list of available tools to the LLM; it decides: answer, or call a tool?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a3f47;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1320" y="450" width="280" height="120" as="geometry"/></mxCell><mxCell id="anatomy-14" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;3 · Act&lt;/b&gt;&lt;br&gt;execute the tool call: shell, file, web, MCP, skill, or spawn a subagent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1320" y="790" width="280" height="120" as="geometry"/></mxCell><mxCell id="anatomy-15" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;4 · Observe&lt;/b&gt;&lt;br&gt;feed the result back into context; save anything worth remembering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="280" height="120" as="geometry"/></mxCell><mxCell id="anatomy-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f2328;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;" edge="1" parent="1" source="anatomy-12" target="anatomy-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-17" value="tool call (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f2328;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;" edge="1" parent="1" source="anatomy-13" target="anatomy-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-18" value="result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f2328;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;" edge="1" parent="1" source="anatomy-14" target="anatomy-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-19" value="&lt;b&gt;not done yet →&lt;br&gt;think again&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#6b6f76&#x27;&gt;(repeat until the task&lt;br&gt;is actually done)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c2410c;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;edgeStyle=none;exitX=1;exitY=0;entryX=0;entryY=1;fontSize=14;" edge="1" parent="1" source="anatomy-15" target="anatomy-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-20" value="Done → final answer goes back out the same channel it came in on" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="915" width="740" height="30" as="geometry"/></mxCell><mxCell id="anatomy-21" value="ENTRY POINTS — how work arrives" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="700" height="30" as="geometry"/></mxCell><mxCell id="anatomy-22" value="&lt;b&gt;CLI / TUI&lt;/b&gt; — type &lt;font face=&#x27;monospace&#x27;&gt;hermes&lt;/font&gt; in a terminal and chat; one-shot commands for scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="700" height="100" as="geometry"/></mxCell><mxCell id="anatomy-23" value="Day 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="690" y="406" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-24" value="&lt;b&gt;Messaging gateway&lt;/b&gt; — the same agent answers on Telegram · Discord · Slack · WhatsApp · Signal · email. Start a task on your laptop, check on it from your phone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="700" height="120" as="geometry"/></mxCell><mxCell id="anatomy-25" value="Day 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="690" y="521" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-26" value="&lt;b&gt;Scheduler (cron)&lt;/b&gt; — natural-language jobs: “every weekday at 8am, summarise my inbox and post it to Telegram”. The agent starts work with nobody asking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="700" height="110" as="geometry"/></mxCell><mxCell id="anatomy-27" value="Day 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="690" y="656" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-22" target="anatomy-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-24" target="anatomy-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-26" target="anatomy-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-31" value="SAFETY &amp; CONTROL" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="700" height="30" as="geometry"/></mxCell><mxCell id="anatomy-32" value="• Approval prompts before risky shell commands&lt;br&gt;• Turn whole toolsets on/off per platform&lt;br&gt;• Run commands in a sandbox backend instead of your host&lt;br&gt;• Everything is plain config you can read: &lt;font face=&#x27;monospace&#x27;&gt;~/.hermes/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="828" width="700" height="122" as="geometry"/></mxCell><mxCell id="anatomy-33" value="Day 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="690" y="834" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-34" value="MODEL PROVIDERS — the brain is swappable" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="118" width="640" height="30" as="geometry"/></mxCell><mxCell id="anatomy-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a3f47;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="156" width="780" height="170" as="geometry"/></mxCell><mxCell id="anatomy-36" value="&lt;b&gt;llama.cpp&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;on DGX Spark&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="168" width="120" height="64" as="geometry"/></mxCell><mxCell id="anatomy-37" value="&lt;b&gt;Ollama&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;on Mac Mini&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="996" y="168" width="120" height="64" as="geometry"/></mxCell><mxCell id="anatomy-38" value="&lt;b&gt;vLLM&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;GPU server&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1124" y="168" width="120" height="64" as="geometry"/></mxCell><mxCell id="anatomy-39" value="&lt;b&gt;OpenRouter&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;100s of models&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1252" y="168" width="120" height="64" as="geometry"/></mxCell><mxCell id="anatomy-40" value="&lt;b&gt;Nous Portal&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;Hermes LLMs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1380" y="168" width="120" height="64" as="geometry"/></mxCell><mxCell id="anatomy-41" value="&lt;b&gt;OpenAI etc.&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#6b6f76&#x27;&gt;cloud APIs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1508" y="168" width="120" height="64" as="geometry"/></mxCell><mxCell id="anatomy-42" value="All reached through one &lt;b&gt;OpenAI-compatible&lt;/b&gt; API. Change &lt;font face=&#x27;monospace&#x27;&gt;model:&lt;/font&gt; in config and the whole agent gets a new brain.&lt;br&gt;&lt;b&gt;Routing (Day 3):&lt;/b&gt; small fast model for lookups, big model for hard reasoning." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1f2328;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="876" y="240" width="750" height="80" as="geometry"/></mxCell><mxCell id="anatomy-43" value="Day 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1504" y="124" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-44" value="Day 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1572" y="124" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-45" value="prompt + tools →&lt;br&gt;← reply / tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3a3f47;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=0.5;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="anatomy-13" target="anatomy-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-46" value="CAPABILITIES — what it can do" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="150" width="640" height="30" as="geometry"/></mxCell><mxCell id="anatomy-47" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Built-in toolsets&lt;/b&gt;&lt;br&gt;terminal · files · web search · browser · code execution · vision · image gen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="190" width="640" height="108" as="geometry"/></mxCell><mxCell id="anatomy-48" value="Day 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2286" y="266" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-49" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;MCP client&lt;/b&gt;&lt;br&gt;connect any MCP server: time, filesystem, GitHub, databases… one config line each" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="310" width="640" height="108" as="geometry"/></mxCell><mxCell id="anatomy-50" value="Day 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2286" y="386" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-51" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Skills&lt;/b&gt;&lt;br&gt;SKILL.md recipes for multi-step procedures — install from a hub, or the agent writes its own after solving something hard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="430" width="640" height="108" as="geometry"/></mxCell><mxCell id="anatomy-52" value="Day 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2286" y="506" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-53" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Subagents&lt;/b&gt;&lt;br&gt;delegate a subtask to a fresh agent with clean context; it returns just the result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="550" width="640" height="108" as="geometry"/></mxCell><mxCell id="anatomy-54" value="Day 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2286" y="626" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-55" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Execution backends&lt;/b&gt;&lt;br&gt;run tools locally, in Docker, over SSH, or in a cloud sandbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="670" width="640" height="108" as="geometry"/></mxCell><mxCell id="anatomy-56" value="Day 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2286" y="746" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-14" target="anatomy-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-14" target="anatomy-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-14" target="anatomy-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-14" target="anatomy-53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anatomy-14" target="anatomy-55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-62" value="MEMORY &amp; KNOWLEDGE — what it knows" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#3a3f47;fontSize=18;fontStyle=1;align=right;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="990" width="460" height="30" as="geometry"/></mxCell><mxCell id="anatomy-63" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;MEMORY.md&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;facts &amp; lessons the agent chose to keep&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="1030" width="186" height="110" as="geometry"/></mxCell><mxCell id="anatomy-64" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;USER.md&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;who you are, how you like things done&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1058" y="1030" width="186" height="110" as="geometry"/></mxCell><mxCell id="anatomy-65" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Session search&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;look back through past conversations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1256" y="1030" width="186" height="110" as="geometry"/></mxCell><mxCell id="anatomy-66" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;RAG over your docs&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;ChromaDB lookup via a tool / MCP&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1454" y="1030" width="186" height="110" as="geometry"/></mxCell><mxCell id="anatomy-67" value="Day 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#3a3f47;fontColor=#3a3f47;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1572" y="994" width="62" height="24" as="geometry"/></mxCell><mxCell id="anatomy-68" value="writes / recalls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c9c4b8;strokeWidth=2;fontColor=#1f2328;fontSize=12;endArrow=block;endFill=1;dashed=0;labelBackgroundColor=#faf8f3;startArrow=block;startFill=1;exitX=0.3;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="anatomy-15" target="anatomy-63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="anatomy-69" value="Memory is why it feels like the &lt;i&gt;same&lt;/i&gt; agent next week. RAG is why it answers from &lt;i&gt;your&lt;/i&gt; documents instead of guessing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;dashed=1;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="1160" width="780" height="70" as="geometry"/></mxCell><mxCell id="anatomy-70" value="ONE REQUEST, END TO END" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#c2410c;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="820" width="640" height="30" as="geometry"/></mxCell><mxCell id="anatomy-71" value="&lt;b&gt;You, on Telegram:&lt;/b&gt; “Check what time it is in Tokyo and remind me at 9am tomorrow to call Kenji.”&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Receive&lt;/b&gt; — gateway delivers the message + your USER.md&lt;br&gt;&lt;b&gt;2 · Think&lt;/b&gt; — model sees a time tool is available → emits a tool call&lt;br&gt;&lt;b&gt;3 · Act&lt;/b&gt; — MCP time server returns Tokyo’s current time&lt;br&gt;&lt;b&gt;4 · Observe&lt;/b&gt; — result goes back in context, not done yet&lt;br&gt;&lt;b&gt;2 · Think&lt;/b&gt; — model decides to create a scheduled job&lt;br&gt;&lt;b&gt;3 · Act&lt;/b&gt; — cron job saved for 9:00 tomorrow&lt;br&gt;&lt;b&gt;Done&lt;/b&gt; — replies on Telegram with the time + confirmation&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#6b6f76&#x27;&gt;Next morning the cron job fires, and the agent messages &lt;i&gt;you&lt;/i&gt; first. That’s Level 4.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=left;verticalAlign=top;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1720" y="858" width="640" height="330" as="geometry"/></mxCell><mxCell id="anatomy-72" value="&lt;b style=&#x27;font-size:15px;color:#3a3f47&#x27;&gt;WHERE IT ALL LIVES&lt;/b&gt;&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;~/.hermes/&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;monospace&#x27;&gt;config.yaml&lt;/font&gt; — model, provider, toolsets, MCP servers&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;monospace&#x27;&gt;.env&lt;/font&gt; — API keys &amp;amp; bot tokens&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;monospace&#x27;&gt;skills/&lt;/font&gt; — installed + self-written SKILL.md files&lt;br&gt;&amp;nbsp;&amp;nbsp;memories — MEMORY.md &amp;amp; USER.md&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#6b6f76&#x27;&gt;No code to write — the whole agent is configuration + Markdown. That’s what makes it teachable in 7 sessions.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=left;verticalAlign=top;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="700" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 · Hermes vs. Neighbors + Course Map" id="compare"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1206" background="#faf8f3" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="compare-1" value="Hermes vs. Its Neighbors — and How the Course Walks the Stack" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1f2328;fontSize=36;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="2320" height="50" as="geometry"/></mxCell><mxCell id="compare-2" value="Five kinds of ‘AI that does things’, compared on what matters when you want an agent that works for you.  Green = yes · amber = partly / depends · red = no." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#6b6f76;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="2320" height="30" as="geometry"/></mxCell><mxCell id="compare-3" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;Chat assistant&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="348" y="120" width="404" height="56" as="geometry"/></mxCell><mxCell id="compare-4" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;Agent framework&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="404" height="56" as="geometry"/></mxCell><mxCell id="compare-5" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;Coding agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1172" y="120" width="404" height="56" as="geometry"/></mxCell><mxCell id="compare-6" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;Enterprise platform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1584" y="120" width="404" height="56" as="geometry"/></mxCell><mxCell id="compare-7" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;★ Hermes Agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0e7;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1996" y="120" width="404" height="56" as="geometry"/></mxCell><mxCell id="compare-8" value="&lt;b&gt;What it is&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="300" height="70" as="geometry"/></mxCell><mxCell id="compare-9" value="A chat window, sometimes with tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="348" y="184" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-10" value="Libraries for building agents in code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="184" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-11" value="An agent that lives in your repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1172" y="184" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-12" value="Managed agents inside a SaaS suite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1584" y="184" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-13" value="&lt;b&gt;A ready-to-run, general-purpose agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1996" y="184" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-14" value="&lt;b&gt;Examples&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="300" height="70" as="geometry"/></mxCell><mxCell id="compare-15" value="ChatGPT · Claude.ai · Open WebUI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="348" y="262" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-16" value="LangGraph · CrewAI · OpenAI Agents SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="262" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-17" value="Claude Code · Codex CLI · Gemini CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1172" y="262" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-18" value="Copilot Studio · Agentforce · Bedrock Agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1584" y="262" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-19" value="&lt;b&gt;Hermes Agent (Nous Research) · cf. OpenClaw&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1996" y="262" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-20" value="&lt;b&gt;No coding needed?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2efe8;strokeColor=#c9c4b8;fontColor=#1f2328;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1.5;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="300" height="70" as="geometry"/></mxCell><mxCell id="compare-21" value="Yes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ee;strokeColor=#b7cdb9;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="348" y="340" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-22" value="No — Python / TypeScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8e9e7;strokeColor=#d9b1ab;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="340" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-23" value="Yes (it writes code for you)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf3e3;strokeColor=#dbc9a0;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1172" y="340" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-24" value="Low-code / config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf3e3;strokeColor=#dbc9a0;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;arcSize=3;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1584" y="340" width="404" height="70" as="geometry"/></mxCell><mxCell id="compare-25" value="&lt;b&gt;Yes — YAML config + Markdown skills&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ee;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=2.5;dashed=0